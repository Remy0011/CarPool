{
    "name": "carpool/carpool-remy",
    "description": "CarPool - PHP carpooling web application",
    "type": "project",
    "require": {
        "php": ">=8.2",
      "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CarPool\\": "src/"
        },
        "files": ["public/config.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "CarPool\\Tests\\": "tests/"
        }
    }
}
